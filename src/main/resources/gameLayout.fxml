<?xml version="1.0" encoding="UTF-8"?>

<?import com.comp2042.GameOverPanel?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.Group?>
<?import java.net.URL?>

<HBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.comp2042.GuiController" spacing="20" style="-fx-padding: 20;">

    <!-- Left side: Game Board -->
    <Pane>
        <BorderPane styleClass="gameBoard" fx:id="gameBoard">
            <center>
                <GridPane fx:id="gamePanel" hgap="1" vgap="1" layoutY="30" layoutX="40"/>
            </center>
        </BorderPane>

        <!-- Notifications -->
        <Group fx:id="groupNotification" layoutX="14" layoutY="203">
            <VBox alignment="CENTER">
                <GameOverPanel fx:id="gameOverPanel"/>
            </VBox>
        </Group>

        <!-- Current brick overlay -->
        <GridPane fx:id="brickPanel" vgap="1" hgap="1"/>
    </Pane>

    <!-- Right side: NEXT + SCORE -->
    <VBox spacing="30" alignment="TOP_CENTER" style="-fx-padding: 40 20 20 20;">
        <Label text="NEXT" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <GridPane fx:id="nextPieceGrid" hgap="1" vgap="1"
                  prefWidth="120" prefHeight="120"
                  style="-fx-background-color: #1a1a1a; -fx-border-color: #444; -fx-border-width: 2;"/>
        <Label fx:id="scoreLabel" text="Score: 0"
               styleClass="scoreClass"
               style="-fx-font-size: 18; -fx-text-fill: white;"/>
    </VBox>

    <!-- Styles -->
    <stylesheets>
        <URL value="@window_style.css"/>
    </stylesheets>
</HBox>