<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.Group?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.geometry.Insets?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.comp2042.GuiController"
           fx:id="rootStackPane"
           alignment="CENTER"
           stylesheets="@window_style.css"
           styleClass="root"
           minWidth="1000"
           minHeight="700"
           prefWidth="1200"
           prefHeight="800">

    <!-- MAIN MENU -->
    <StackPane fx:id="mainMenuContainer" alignment="CENTER" visible="true">
    </StackPane>

    <!-- GAME SCREEN -->
    <StackPane fx:id="gameContainer" alignment="CENTER" visible="false">

        <!-- Main Layout -->
        <HBox fx:id="gameHBox" alignment="CENTER" spacing="40">
            <padding>
                <Insets top="40" right="60" bottom="40" left="60"/>
            </padding>

            <!-- LEFT COLUMN -->
            <VBox fx:id="leftColumn" spacing="18" alignment="TOP_CENTER"
                  minWidth="140" prefWidth="140" maxWidth="140">

                <!-- HOLD PIECE BOX -->
                <VBox styleClass="info-box-container">
                    <HBox styleClass="info-header">
                        <Label text="Hold" styleClass="info-header-text"/>
                    </HBox>
                    <StackPane styleClass="info-content, info-content-hold">
                        <GridPane fx:id="holdPieceGrid" alignment="CENTER"
                                  hgap="1" vgap="1"/>
                    </StackPane>
                </VBox>

                <!-- SPACER -->
                <Region VBox.vgrow="ALWAYS" minHeight="20"/>

                <!-- STATS GROUP -->
                <VBox spacing="15" alignment="CENTER">
                    <VBox styleClass="info-box-container">
                        <HBox styleClass="info-header">
                            <Label text="High Score" styleClass="info-header-text"/>
                        </HBox>
                        <StackPane styleClass="info-content">
                            <Label fx:id="highScoreLabel" text="0"
                                   styleClass="info-value-text"/>
                        </StackPane>
                    </VBox>

                    <VBox styleClass="info-box-container">
                        <HBox styleClass="info-header">
                            <Label text="Level" styleClass="info-header-text"/>
                        </HBox>
                        <StackPane styleClass="info-content">
                            <Label fx:id="levelLabel" text="1"
                                   styleClass="info-value-text"/>
                        </StackPane>
                    </VBox>

                    <VBox styleClass="info-box-container">
                        <HBox styleClass="info-header">
                            <Label text="Score" styleClass="info-header-text"/>
                        </HBox>
                        <StackPane styleClass="info-content">
                            <Label fx:id="scoreLabel" text="0"
                                   styleClass="info-value-text"/>
                        </StackPane>
                    </VBox>

                    <VBox styleClass="info-box-container">
                        <HBox styleClass="info-header">
                            <Label text="Lines" styleClass="info-header-text"/>
                        </HBox>
                        <StackPane styleClass="info-content">
                            <Label fx:id="linesLabel" text="0"
                                   styleClass="info-value-text"/>
                        </StackPane>
                    </VBox>
                </VBox>
            </VBox>

            <!-- GAME BOARD - Sizes set dynamically by Java -->
            <StackPane fx:id="boardContainer" styleClass="game-board-container" alignment="CENTER">
                <Pane fx:id="rootPane"
                      style="-fx-background-color: #0d1421;">

                    <!-- Blue Border -->
                    <Rectangle fx:id="boardBorder" layoutX="0" layoutY="0"
                               strokeType="OUTSIDE"
                               styleClass="game-border-rect"/>

                    <!-- Dark Background -->
                    <Rectangle fx:id="boardBackground" layoutX="0" layoutY="0"
                               fill="#0d1421" mouseTransparent="true"/>

                    <!-- Grid -->
                    <Pane fx:id="gamePanel"
                          layoutX="0" layoutY="0"
                          styleClass="game-grid"/>

                    <!-- Ghost Layer -->
                    <Pane fx:id="ghostPanel" layoutX="0" layoutY="0"
                          pickOnBounds="false" mouseTransparent="true"/>

                    <!-- Falling Piece Layer -->
                    <Pane fx:id="brickPanel" layoutX="0" layoutY="0"
                          pickOnBounds="false"/>

                    <!-- Notifications -->
                    <Pane fx:id="notificationLayer" layoutX="0" layoutY="0"
                          pickOnBounds="false">
                        <Group fx:id="groupNotification" mouseTransparent="true"/>
                    </Pane>
                </Pane>
            </StackPane>

            <!-- RIGHT COLUMN -->
            <VBox fx:id="rightColumn" spacing="15" alignment="TOP_CENTER"
                  minWidth="140" prefWidth="140" maxWidth="140">

                <!-- NEXT PIECES BOX -->
                <VBox styleClass="info-box-container-wide">
                    <HBox styleClass="info-header-wide">
                        <Label text="Next" styleClass="info-header-text"/>
                    </HBox>
                    <VBox fx:id="nextPiecesContainer"
                          styleClass="info-content-wide, info-content-next"
                          spacing="8" alignment="TOP_CENTER"/>
                </VBox>
            </VBox>

        </HBox>

        <!-- OVERLAYS -->
        <StackPane fx:id="overlayLayer" alignment="CENTER"
                   pickOnBounds="false" mouseTransparent="true">

            <!-- Pause Menu -->
            <StackPane fx:id="pauseContainer" visible="false"
                       pickOnBounds="true" mouseTransparent="false">
            </StackPane>

            <!-- Name Input -->
            <StackPane fx:id="nameInputContainer" visible="false"
                       pickOnBounds="true" mouseTransparent="false">
            </StackPane>

            <!-- Game Over -->
            <StackPane fx:id="gameOverContainer" visible="false"
                       pickOnBounds="true" mouseTransparent="false">
            </StackPane>
        </StackPane>

        <!-- PAUSE BUTTON - Must be after overlays to stay clickable -->
        <StackPane alignment="BOTTOM_RIGHT" pickOnBounds="false">
            <padding>
                <Insets top="0" right="30" bottom="30" left="0"/>
            </padding>
            <Button fx:id="pauseButton"
                    text="||"
                    styleClass="pause-button"
                    onMouseEntered="#onPauseButtonHover"
                    onMouseExited="#onPauseButtonExit"
                    onAction="#togglePause"
                    focusTraversable="false"/>
        </StackPane>

    </StackPane>

    <!-- Controls Panel -->
    <StackPane fx:id="controlsContainer" alignment="CENTER" visible="false"
               pickOnBounds="true" mouseTransparent="false">
    </StackPane>

    <!-- Settings Panel -->
    <StackPane fx:id="settingsContainer" alignment="CENTER" visible="false"
               pickOnBounds="true" mouseTransparent="false">
    </StackPane>

    <!-- Customize Panel -->
    <StackPane fx:id="customizeContainer" alignment="CENTER" visible="false"
               pickOnBounds="true" mouseTransparent="false">
    </StackPane>

</StackPane>